@model BookClass.BookClass

@{
    ViewData["Title"] = "Buch löschen";
}

<div class="page-header">
    <h1 class="text-danger"><i class="bi bi-trash me-2"></i>Buch löschen</h1>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-3" style="font-size: 2rem;"></i>
                    <div>
                        <h5 class="mb-0">Möchten Sie dieses Buch wirklich löschen?</h5>
                        <small class="text-muted">Diese Aktion kann nicht rückgängig gemacht werden.</small>
                    </div>
                </div>

                <dl class="row bg-light rounded p-3 mb-0">
                    <dt class="col-sm-4 text-muted">Buch-ID</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.BookId)</dd>

                    <dt class="col-sm-4 text-muted">Titel</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.BookName)</dd>

                    <dt class="col-sm-4 text-muted">Autor</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.BookAuthor)</dd>

                    <dt class="col-sm-4 text-muted">Veröffentlicht</dt>
                    <dd class="col-sm-8">@Model.BookDate.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4 text-muted">Eigentümer</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.UserId)</dd>
                </dl>

                <form asp-action="Delete" class="mt-4">
                    <input type="hidden" asp-for="BookId" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Löschen
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Abbrechen
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
