@model AuthViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Registrieren";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4">
            <h2 class="page-header h4"><i class="bi bi-person-plus me-2"></i>Konto erstellen</h2>

            <form asp-controller="User" asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">Benutzername</label>
                    <input asp-for="UserName" class="form-control" placeholder="Max Mustermann" autofocus />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UserEmail" class="form-label">E-Mail</label>
                    <input asp-for="UserEmail" type="email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="UserEmail" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UserPassword" class="form-label">Passwort</label>
                    <input asp-for="UserPassword" type="password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="UserPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Passwort bestätigen</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-accent w-100">
                    <i class="bi bi-person-plus me-1"></i>Registrieren
                </button>
            </form>

            <p class="small text-muted mt-3 mb-0 text-center">
                Bereits ein Konto? <a asp-controller="User" asp-action="Login">Anmelden</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
