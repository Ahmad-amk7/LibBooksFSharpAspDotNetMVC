@model AuthViewModels.ActivateViewModel
@{
    ViewData["Title"] = "Konto aktivieren";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card p-4">
            <h2 class="page-header h4"><i class="bi bi-envelope-check me-2"></i>Konto aktivieren</h2>

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info"><i class="bi bi-info-circle me-1"></i>@TempData["Message"]</div>
            }
            @if (TempData["DevCode"] != null)
            {
                <div class="alert alert-warning"><strong>DEV-MODUS:</strong> Ihr Aktivierungscode lautet <code class="fw-bold">@TempData["DevCode"]</code></div>
            }

            <form asp-controller="User" asp-action="Activate" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-Mail</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Code" class="form-label">Aktivierungscode (6 Ziffern)</label>
                    <input asp-for="Code" class="form-control text-center fs-5" maxlength="6"
                           placeholder="000000" inputmode="numeric" autocomplete="one-time-code" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-accent w-100">
                    <i class="bi bi-check-circle me-1"></i>Aktivieren
                </button>
            </form>

            <hr class="my-4" />

            <h6 class="small fw-bold text-muted mb-2"><i class="bi bi-arrow-repeat me-1"></i>Neuen Code angefordert?</h6>
            <form asp-controller="User" asp-action="ResendCode" method="post" class="d-flex gap-2">
                <input name="email" type="email" class="form-control form-control-sm" placeholder="Ihre E-Mail" required />
                <button type="submit" class="btn btn-outline-secondary btn-sm text-nowrap">
                    <i class="bi bi-send me-1"></i>Erneut senden
                </button>
            </form>

            <p class="small text-muted mt-3 mb-0 text-center">
                <a asp-controller="User" asp-action="Login"><i class="bi bi-arrow-left me-1"></i>Zurück zur Anmeldung</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
