@model UserAccount.UserAccount

@{
    ViewData["Title"] = "Konto löschen";
}

<div class="page-header">
    <h1 class="text-danger"><i class="bi bi-trash me-2"></i>Konto löschen</h1>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-3" style="font-size: 2rem;"></i>
                    <div>
                        <h5 class="mb-0">Möchten Sie Ihr Konto wirklich löschen?</h5>
                        <small class="text-muted">
                            <strong class="text-danger">Warnung:</strong> Alle Ihre Bücher werden ebenfalls gelöscht (Kaskade).
                            Diese Aktion kann nicht rückgängig gemacht werden.
                        </small>
                    </div>
                </div>

                <dl class="row bg-light rounded p-3 mb-0">
                    <dt class="col-sm-4 text-muted">Benutzer-ID</dt>
                    <dd class="col-sm-8"><code>@Html.DisplayFor(model => model.UserId)</code></dd>

                    <dt class="col-sm-4 text-muted">Name</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.UserName)</dd>

                    <dt class="col-sm-4 text-muted">E-Mail</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.UserEmail)</dd>
                </dl>

                <form asp-action="Delete" class="mt-4">
                    <input type="hidden" asp-for="UserId" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Konto löschen
                        </button>
                        <a asp-action="Profile" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Abbrechen
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
